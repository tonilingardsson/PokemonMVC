@model PokemonMVC.Models.PokemonListResponse

@{
    ViewData["Title"] = "Pokemon List";
}

<h1>Pokémon</h1>

<form asp-action="Search" asp-controller="Pokemon" method="post">
    <input type="text" name="searchTerm" placeholder="Search Pokémon by name" />
    <button type="submit">Search</button>
</form>

@if (ViewBag.ErrorMessage != null)
{
    <p>@ViewBag.ErrorMessage</p>
}

@if (Model != null && Model.Results != null && Model.Results.Any())
{
    <ul>
        @foreach (var pokemon in Model.Results)
        {
            <li>
                <a asp-action="Details" asp-controller="Pokemon" asp-route-id="@pokemon.Name">
                    @pokemon.Name
                </a>
            </li>
        }
    </ul>
}
else
{
    <p>No Pokémon found.</p>
}